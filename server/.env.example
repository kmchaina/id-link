PORT=3001
DATABASE_URL=postgres://postgres:password@localhost:5432/idlink

# 64 hex chars = 32 bytes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_me_64_hex_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any long random string for HMAC-SHA256 ID number hashing
HMAC_KEY=change_me_hmac_secret

# JWT signing secret
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRES_IN=8h

NODE_ENV=development

# Google Vision API key (for OCR in production)
# GOOGLE_VISION_API_KEY=

# SMS aggregator credentials (Selcom / Pesapal / AzamPay)
# SMS_API_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=ID-Link
